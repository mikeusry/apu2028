---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

---

<Layout>
  <div class="preview-banner">Preview draft. Not launched. Highlighted fields are placeholders.</div>

  <header class="sticky top-0 z-30 bg-navy/95 backdrop-blur text-white">
    <nav class="max-w-5xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="#top" class="font-extrabold tracking-tight">APU <span class="text-accent font-semibold">2029</span></a>
      <div class="hidden sm:flex gap-5 text-sm font-medium">
        <a href="#highlights" class="hover:text-accent">Highlights</a>
        <a href="#facts" class="hover:text-accent">Facts</a>
        <a href="#schedule" class="hover:text-accent">Schedule</a>
        <a href="#academics" class="hover:text-accent">Academics</a>
        <a href="#contact" class="hover:text-accent">Contact</a>
      </div>
      <a href="#contact" class="sm:hidden text-sm font-semibold bg-white text-navy px-3 py-1.5 rounded-md">Contact</a>
    </nav>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero text-white">
      <div class="max-w-5xl mx-auto px-4 py-16 md:py-24">
        <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold">Women's Flag Football Recruit</p>
        <h1 class="mt-3 text-4xl md:text-6xl font-extrabold leading-tight">Ayn Parker Usry</h1>
        <div class="mt-5 flex flex-wrap gap-2 text-sm md:text-base">
          <span class="chip">Class of 2029</span>
          <span class="chip">WR / QB</span>
          <span class="chip">#7</span>
          <span class="chip">5'6"</span>
        </div>
        <p class="mt-5 text-white/80 max-w-xl">Clarke Central flag football &middot; Athens, GA &middot; Multi-sport varsity athlete</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#highlights" class="btn-light">Watch highlights</a>
          <a href="#contact" class="btn-outline">Contact family</a>
        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section id="highlights" class="section">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Highlights</h2>
        <div class="mt-6 rounded-2xl overflow-hidden shadow-lg bg-black">
          <video id="jackson-county-vs-mountain-view" class="w-full aspect-video" controls preload="metadata" playsinline
            poster="/video/jackson-county-vs-mountain-view.jpg">
            <source src="/video/jackson-county-vs-mountain-view.mp4" type="video/mp4" />
          </video>
        </div>
        <h3 class="mt-4 text-lg font-bold">Jackson County vs Mountain View highlights</h3>
        <p class="text-gray-600 text-sm mt-1">4 interceptions &middot; 0:43 &middot; <span class="ph">[Confirm Ayn appears in this clip / replace with Clarke Central film]</span></p>
      </div>
    </section>

    <!-- Quick facts -->
    <section id="facts" class="section bg-gray-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Quick facts</h2>
        <div class="mt-6 card grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 overflow-hidden">
          <div class="fact"><span class="label">Class</span><span class="value">2029</span></div>
          <div class="fact"><span class="label">Height</span><span class="value">5'6"</span></div>
          <div class="fact"><span class="label">Flag position</span><span class="value">WR / QB</span></div>
          <div class="fact"><span class="label">Jersey</span><span class="value">#7</span></div>
          <div class="fact col-span-2"><span class="label">Flag football team</span><span class="value">Clarke Central (GA), varsity</span></div>
          <div class="fact col-span-2"><span class="label">Softball club</span><span class="value">Top Gun Walker <span class="text-sm font-medium text-gray-500">(formerly Stars National Walker)</span></span></div>
        </div>
        <div class="mt-6 grid md:grid-cols-2 gap-4">
          <div class="card p-5">
            <h3 class="font-bold">Flag football stats</h3>
            <p class="mt-2 ph block">[Season stats TBD]</p>
          </div>
          <div class="card p-5">
            <h3 class="font-bold">Flag football honors</h3>
            <p class="mt-2 ph block">[Flag honors TBD]</p>
          </div>
        </div>
        <div class="mt-4 card p-5 md:p-6">
          <h3 class="font-bold">Athletic background</h3>
          <div class="mt-3 grid md:grid-cols-2 gap-6 text-gray-700">
            <div>
              <p class="label">Track &amp; field</p>
              <ul class="mt-2 space-y-1.5 list-disc pl-5">
                <li>State track finalist, triple jump</li>
                <li>60m: 8.86 laser-timed (5A Georgia meet)</li>
                <li>4x100m relay leg, curve runner</li>
              </ul>
            </div>
            <div>
              <p class="label">Softball (outfield, bats R / throws R)</p>
              <ul class="mt-2 space-y-1.5 list-disc pl-5">
                <li>2026 Alliance Fastpitch 16U Tier III National Runner-Up</li>
                <li>2025 Alliance Atlantic Region Champions</li>
                <li>Exit velo 73 mph; outfield velo 65 mph</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Schedule -->
    <section id="schedule" class="section">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Upcoming schedule</h2>
        <div class="mt-6 card divide-y">
          <div class="p-4 flex flex-col sm:flex-row sm:justify-between gap-1"><span class="ph">[Date TBD]</span><span class="ph">[Event / opponent TBD]</span><span class="ph">[Location TBD]</span></div>
          <div class="p-4 flex flex-col sm:flex-row sm:justify-between gap-1"><span class="ph">[Date TBD]</span><span class="ph">[Event / opponent TBD]</span><span class="ph">[Location TBD]</span></div>
        </div>
      </div>
    </section>

    <!-- Academics -->
    <section id="academics" class="section bg-gray-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Academics</h2>
        <div class="mt-6 grid sm:grid-cols-2 md:grid-cols-4 gap-4">
          <div class="card p-5"><span class="label">GPA</span><span class="value">3.74</span></div>
          <div class="card p-5"><span class="label">School</span><span class="value">Liberty University Online Academy</span></div>
          <div class="card p-5"><span class="label">Intended major</span><span class="value">Business (Finance)</span></div>
          <div class="card p-5"><span class="label">Honors</span><span class="value">BETA Club inductee, 2025-26</span></div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Contact</h2>
        <div class="mt-6 card p-6 md:p-8">
          <p class="text-gray-700">Coaches: please reach out through Ayn's parent.</p>
          <p class="mt-3 text-lg font-semibold"><span class="ph">[Parent contact TBD]</span></p>
          <p class="mt-4 text-sm text-gray-500">X: <a class="underline" href="https://x.com/AynParkerUsry">@AynParkerUsry</a></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-navy text-white/70 text-sm">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between gap-2">
      <span>&copy; 2026 Ayn Parker Usry</span>
      <span>Class of 2029 &middot; Women's Flag Football</span>
    </div>
  </footer>
</Layout>

<style is:global>
  .preview-banner { background:#fde047; color:#422006; text-align:center; font-size:.8rem; font-weight:700; padding:.4rem 1rem; }
  .hero { background: radial-gradient(1200px 500px at 80% -10%, #1d5a8c 0%, transparent 60%), linear-gradient(160deg, #041d35 0%, #062a4b 60%, #0d3a5c 100%); }
  .chip { display:inline-flex; align-items:center; padding:.35rem .8rem; border-radius:999px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2); font-weight:600; }
  .ph { background:#fef08a !important; color:#713f12 !important; border:2px dashed #ca8a04 !important; border-radius:.375rem; padding:0 .4rem; font-style:italic; font-weight:600; }
  .chip.ph { border-radius:999px; padding:.3rem .8rem; }
  .btn-light { display:inline-flex; padding:.75rem 1.25rem; border-radius:.6rem; background:#fff; color:#062a4b; font-weight:700; }
  .btn-outline { display:inline-flex; padding:.75rem 1.25rem; border-radius:.6rem; border:2px solid rgba(255,255,255,.6); color:#fff; font-weight:700; }
  .section { padding: 3.5rem 0; }
  @media (min-width: 768px) { .section { padding: 5rem 0; } }
  .section-title { font-size:1.75rem; font-weight:800; color:#062a4b; letter-spacing:-.01em; }
  .card { background:#fff; border:1px solid #e5e7eb; border-radius:1rem; box-shadow:0 1px 2px rgba(0,0,0,.04); }
  .fact { background:#fff; padding:1.1rem 1.25rem; display:flex; flex-direction:column; gap:.35rem; }
  .label { display:block; font-size:.72rem; text-transform:uppercase; letter-spacing:.12em; color:#6b7280; font-weight:600; }
  .value { display:inline-block; font-size:1.15rem; font-weight:700; color:#111827; margin-top:.25rem; }
  .fact .value { margin-top:0; align-self:flex-start; }
</style>
