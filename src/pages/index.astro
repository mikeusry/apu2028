---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import VideoGrid from '../components/VideoGrid.astro';
// All site videos are on Mux (public playback). One line per video in src/data/site-videos.json; order = display order.
import videos from '../data/site-videos.json';
const byId = (ids: string[]) => ids.map((id) => videos.find((v) => v.id === id)).filter(Boolean) as typeof videos;
// First game reel = featured "Start here" clip (Elbert County); the rest go in the smaller grid.
const gameVideos = videos.filter((v) => v.category === 'game');
const speedVideos = byId(['60m-dash-886', 'hurdles-region', '4x100-relay']);
const strengthVideos = byId(['box-squat-245x5x5', 'pin-squat-330', 'summer-workouts']);
// Upcoming Clarke Central games, copied from MaxPreps (src/data/flag-schedule.json). Section hides when empty.
import schedule from '../data/flag-schedule.json';
const MAXPREPS_SCHEDULE = 'https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/26-27/schedule/';
const MAXPREPS_TEAM = 'https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/';

// PERSONAL INTRO: 2-3 sentences in Ayn's own words, shown beside the portrait.
// Leave empty until she writes it; the block is not rendered while this is ''.
const intro = "I love flag football because it combines fast-paced strategy with the pure joy of competition, making every play an exciting challenge. For me, competing isn't just about winning; it's about pushing my limits, sharpening my skills, and enjoying the thrill of the game. As a teammate, I'm encouraging, dependable, and always focused on bringing out the best in everyone around me so we can succeed together.";

// Album photos (Photos > "AP Flag Football"); resized, EXIF/GPS stripped. Crop/resize only.
// Editorial layout: one lead image + three supporting shots. The two night/stadium shots get a light CSS
// brightness lift (.lift) so the set reads evenly; the files themselves are untouched.
const leadPhoto = { src: '/photos/ayn-7-ball-carry-night.jpg', w: 1200, h: 854, alt: 'Interception return', cap: 'Interception return', pos: '50% 42%' };
const supportPhotos = [
  { src: '/photos/ayn-qb-throw-pink.jpg', w: 900, h: 1281, alt: 'Ayn Parker #7 setting to throw in a pink Clarke Central jersey', cap: 'At QB · Oct 17', pos: '38% 40%', cls: 'ph-tall', lift: false },
  { src: '/photos/ayn-7-white-sideline.jpg', w: 1200, h: 800, alt: 'Ayn Parker #7 in white, seen from behind', cap: 'Sep 23', pos: '82% 35%', cls: '', lift: true },
  { src: '/photos/ayn-7-route-white.jpg', w: 842, h: 1600, alt: 'Ayn Parker #7 in a white Clarke Central jersey on the field', cap: 'Sep 23', pos: '22% 62%', cls: '', lift: true },
];
---

<Layout>

  <header class="sticky top-0 z-30 bg-ink/90 backdrop-blur border-b border-white/10 text-white">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 py-2 md:py-3">
      <a href="#top" class="font-extrabold tracking-tight">APU <span class="text-gold">2029</span></a>
      <div class="hidden md:flex gap-5 text-sm font-semibold text-white/95">
        <a href="#film" class="nav-link">Film</a>
        <a href="#facts" class="nav-link">Facts</a>
        <a href="#speed" class="nav-link">Speed</a>
        <a href="#strength" class="nav-link">Strength</a>
        <a href="#two-sport" class="nav-link">Softball</a>
        <a href="#academics" class="nav-link">Academics</a>
        {schedule.length > 0 && <a href="#schedule" class="nav-link">Schedule</a>}
        <a href="#contact" class="nav-link">Contact</a>
      </div>
      <a href="#contact" class="md:hidden text-xs font-bold bg-gold text-ink px-3 py-1 rounded-md">Contact</a>
    </nav>
  </header>

  <main id="top">
    <!-- 1. Hero: running photo, dark fade so text stays readable; Ayn sits ~62% across the frame -->
    <section class="hero relative overflow-hidden text-white">
      <img src="/photos/hero-ayn-run-7.jpg" alt="Ayn Parker, #7, running with the ball" width="1591" height="1045" fetchpriority="high" class="hero-img absolute inset-0 w-full h-full object-cover" />
      <div class="hero-fade absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-6xl mx-auto px-4 hero-inner">
        <div class="max-w-md">
          <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-gold font-bold">Women's flag football</p>
          <h1 class="mt-3 text-[2.6rem] sm:text-5xl md:text-7xl font-extrabold leading-[1.02] tracking-tight">Ayn Parker Usry</h1>
          <div class="mt-5 flex flex-wrap gap-2 text-sm md:text-base">
            <span class="chip chip-gold">#7</span>
            <span class="chip">Class of 2029</span>
            <span class="chip">WR / QB / Safety</span>
          </div>
          <p class="mt-3 text-sm md:text-base text-gold font-semibold">Class of 2029 &middot; Available for fall 2028 college enrollment</p>
          <p class="mt-5 text-white/85"><a href={MAXPREPS_TEAM} target="_blank" rel="noopener" class="link-gold">Clarke Central</a> &middot; Athens, GA</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#film" class="btn-gold">Watch game film</a>
            <a href="#contact" class="btn-outline">Contact</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Game film: one featured reel, other games smaller below -->
    <section id="film" class="section pt-8 md:pt-12">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Game film</p>
        <h2 class="section-title">Clarke Central highlights</h2>
        <VideoGrid videos={gameVideos} variant="feature" label="Start here · Flag football highlights" />
      </div>
    </section>

    <!-- Video lightbox (single player, loaded on first click) -->
    <div id="video-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4" role="dialog" aria-modal="true" aria-label="Video player">
      <button type="button" id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10" aria-label="Close video">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <div class="w-full max-w-5xl">
        <div id="lightbox-slot" class="aspect-video w-full bg-black rounded-lg overflow-hidden"></div>
        <p id="lightbox-title" class="mt-3 text-center text-white/90 text-sm font-semibold"></p>
      </div>
    </div>

    <script is:inline>
      (function () {
        var MUX_SRC = 'https://cdn.jsdelivr.net/npm/@mux/mux-player@3';
        var box = document.getElementById('video-lightbox');
        var slot = document.getElementById('lightbox-slot');
        var label = document.getElementById('lightbox-title');
        var player = null, loading = null;
        function loadMux() {
          if (loading) return loading;
          loading = new Promise(function (res, rej) {
            var s = document.createElement('script');
            s.src = MUX_SRC; s.onload = res; s.onerror = rej;
            document.head.appendChild(s);
          });
          return loading;
        }
        function open(btn) {
          var pid = btn.getAttribute('data-playback-id');
          var vid = btn.getAttribute('data-video-id');
          var title = btn.getAttribute('data-title') || '';
          label.textContent = title;
          var vert = btn.getAttribute('data-vertical') === '1';
          slot.style.aspectRatio = vert ? '9 / 16' : '16 / 9';
          slot.style.maxHeight = vert ? '80vh' : '';
          slot.style.width = vert ? 'auto' : '100%';
          slot.style.margin = vert ? '0 auto' : '';
          box.classList.remove('hidden'); box.classList.add('flex');
          document.body.style.overflow = 'hidden';
          loadMux().then(function () {
            if (!player) {
              player = document.createElement('mux-player');
              player.setAttribute('stream-type', 'on-demand');
              player.setAttribute('accent-color', '#EEA43B');
              player.setAttribute('autoplay', 'any');
              player.style.cssText = 'width:100%;height:100%;display:block';
              slot.appendChild(player);
            }
            player.setAttribute('metadata-video-title', title);
            if (player.getAttribute('playback-id') === pid) {
              var p = player.play && player.play();
              if (p && p.catch) p.catch(function () {});
            } else {
              player.setAttribute('playback-id', pid);
            }
          });
          if (window.apuTrack && window.apuTrack.videoPlay) window.apuTrack.videoPlay(vid);
        }
        function close() {
          if (player && player.pause) player.pause();
          box.classList.add('hidden'); box.classList.remove('flex');
          document.body.style.overflow = '';
        }
        // Delegated: this script runs before the film/track/strength markup exists, so bind on document.
        document.addEventListener('click', function (e) {
          var b = e.target && e.target.closest ? e.target.closest('.video-thumb') : null;
          if (b) { e.preventDefault(); open(b); }
        });
        document.getElementById('lightbox-close').addEventListener('click', close);
        box.addEventListener('click', function (e) { if (e.target === box) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.classList.contains('hidden')) close(); });
      })();
    </script>

    <!-- 3. Portrait + quick facts (GPA and major live in Academics only) -->
    <section id="facts" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-6 md:gap-12 items-center">
        <figure class="photo-frame aspect-[5/4] md:aspect-[3/4]">
          <img src="/photos/ayn-7-portrait-black.jpg" alt="Ayn Parker #7 in a black Clarke Central jersey" width="900" height="1831" loading="lazy" class="w-full h-full object-cover" style="object-position:50% 20%" />
        </figure>
        <div>
          <p class="eyebrow">Athlete profile</p>
          <h2 class="section-title">Meet Ayn Parker</h2>
          {/* PERSONAL INTRO SLOT: renders only when `intro` (frontmatter) has text. */}
          {intro && <p class="intro mt-4">{intro}</p>}
          <dl class="mt-5 facts-grid">
            <div class="fact col-span-2"><dt class="label">Full name</dt><dd class="value">Aynsley Parker Usry</dd></div>
            <div class="fact"><dt class="label">Height</dt><dd class="value">5'7"</dd></div>
            <div class="fact"><dt class="label">Weight</dt><dd class="value">135 lbs</dd></div>
            <div class="fact"><dt class="label">Class</dt><dd class="value">2029 (available for fall 2028 enrollment)</dd></div>
            <div class="fact"><dt class="label">Position</dt><dd class="value">WR / QB / Safety</dd></div>
            <div class="fact"><dt class="label">Flag team</dt><dd class="value"><a href={MAXPREPS_TEAM} target="_blank" rel="noopener" class="link-gold">Clarke Central</a> varsity</dd></div>
            <div class="fact"><dt class="label">Hometown</dt><dd class="value">Athens, GA</dd></div>
            <div class="fact col-span-2"><dt class="label">NCAA ID</dt><dd class="value"><a href="https://web3.ncaa.org/ecwr3/" target="_blank" rel="noopener" class="link-gold">2509718485</a></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 3b. Family (text approved by Mike, Oct 28 2026). No article photos or UGA logos. -->
    <section id="family" class="bg-ink-2 pb-8 md:pb-10">
      <div class="max-w-6xl mx-auto px-4">
        <div class="family border-t border-white/15 pt-5 md:pt-6 max-w-3xl">
          <h2 class="text-xl md:text-2xl font-extrabold text-white">An athletic family</h2>
          <p class="mt-2 text-white/90 leading-relaxed">Ayn Parker comes from a family that knows what it takes to compete in college. Her mom, Karin (Lichey) Usry, was an 11-time All-American gymnast at Georgia and won NCAA titles with the GymDogs in 1998 and 1999. Her dad, Mike Usry, was a quarterback for the Bulldogs from 1996 to 1999. They understand the demands of being a college athlete, from the early workouts to balancing school and travel, and they've raised Ayn Parker with that in mind.</p>
          <p class="mt-2 text-sm"><a class="link-gold font-semibold" href="https://www.redandblack.com/sports/this-was-home-former-bulldogs-karin-and-mike-usry-raise-family-in-athens/article_73c4a170-b9b0-11ea-8720-bb60a2e7f32f.html" target="_blank" rel="noopener">Read the Red &amp; Black story</a></p>
        </div>
      </div>
    </section>

    <!-- 4. Speed: featured number, other events, achievement, then clips -->
    <section id="speed" class="section">
      <div class="max-w-6xl mx-auto px-4 lg:grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-12 lg:items-start">
        <div>
          <p class="eyebrow">Speed</p>
          <h2 class="section-title">Track &amp; field</h2>
          <div class="mt-5 grid grid-cols-1 sm:grid-cols-[auto_1fr] lg:grid-cols-1 gap-5 sm:gap-10 lg:gap-5 items-center">
            <div>
              <p class="text-6xl md:text-7xl font-extrabold text-gold leading-none tracking-tight">8.86<span class="text-2xl md:text-3xl ml-1.5 text-white">sec</span></p>
              <p class="mt-2 text-sm font-bold uppercase tracking-[0.14em] text-white">60m &middot; laser-timed</p>
              <p class="text-sm text-white/85">5A Georgia meet</p>
            </div>
            <div class="sm:border-l sm:border-white/15 sm:pl-10 lg:border-l-0 lg:pl-0 lg:border-t lg:pt-4">
              <p class="label">Other events</p>
              <ul class="mt-1.5 space-y-1 text-white">
                <li><span class="font-semibold">Hurdles</span> <span class="text-white/85">&middot; region track meet</span></li>
                <li><span class="font-semibold">4x100 relay</span> <span class="text-white/85">&middot; curve leg</span></li>
              </ul>
              <p class="mt-4 inline-flex flex-wrap items-center gap-2 text-white"><span class="badge-red">Achievement</span><span class="font-semibold">State finalist &middot; triple jump</span></p>
            </div>
          </div>
        </div>
        <div class="lg:-mt-5"><VideoGrid videos={speedVideos} /></div>
      </div>
    </section>

    <!-- 5. Strength: numbers inline with the heading, then clips -->
    <section id="strength" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4 lg:grid lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] lg:gap-12 lg:items-start">
        <div class="lg:order-2">
          <p class="eyebrow">Strength</p>
          <h2 class="section-title">Weight room</h2>
          <dl class="mt-4 flex gap-8">
            <div class="flex flex-col-reverse"><dt class="mt-1 text-sm text-white/80">Box squat, 5x5</dt><dd class="text-4xl font-extrabold text-gold leading-none">245<span class="text-base text-white ml-1">lb</span></dd></div>
            <div class="flex flex-col-reverse"><dt class="mt-1 text-sm text-white/80">Pin squat</dt><dd class="text-4xl font-extrabold text-gold leading-none">330<span class="text-base text-white ml-1">lb</span></dd></div>
          </dl>
        </div>
        <div class="lg:order-1 lg:-mt-5"><VideoGrid videos={strengthVideos} /></div>
      </div>
    </section>

    <!-- 6. Photos: editorial (one lead + three supporting) -->
    <section id="photos" class="section">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">On the field</p>
        <h2 class="section-title">Photos</h2>
        <div class="mt-5 photo-ed">
          <figure class="ph-lead photo-frame relative">
            <img src={leadPhoto.src} alt={leadPhoto.alt} width={leadPhoto.w} height={leadPhoto.h} loading="lazy" class="w-full h-full object-cover" style={`object-position:${leadPhoto.pos}`} />
            <figcaption class="ph-cap">{leadPhoto.cap}</figcaption>
          </figure>
          {supportPhotos.map((p) => (
            <figure class={`photo-frame relative ${p.cls}`}>
              <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" class={`w-full h-full object-cover ${p.lift ? 'lift' : ''}`} style={`object-position:${p.pos}`} />
              <figcaption class="ph-cap hidden md:block">{p.cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Softball + Academics side by side (one clean info block, no cards) -->
    <section class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 md:gap-0">
        <div id="two-sport" class="md:pr-12">
          <p class="eyebrow">Two-sport athlete</p>
          <h2 class="section-title">Softball</h2>
          <p class="mt-2 text-white/80">Outfielder for a 16U Elite National Team - Top Gun National Walker. Bats right, throws right.</p>
          <ul class="mt-4 space-y-2.5">
            <li class="flex gap-3 items-baseline"><span class="honor-year">2026</span><span class="font-semibold">Alliance Fastpitch 16U Tier III National Runner-Up</span></li>
            <li class="flex gap-3 items-baseline"><span class="honor-year">2025</span><span class="font-semibold">Alliance Atlantic Region Champions</span></li>
          </ul>
        </div>
        <div id="academics" class="md:pl-12 md:border-l md:border-white/15">
          <p class="eyebrow">Academics</p>
          <h2 class="section-title">In the classroom</h2>
          <dl class="mt-4 info-block">
            <div><dt>GPA</dt><dd class="text-gold text-xl font-extrabold">3.74</dd></div>
            <div><dt>School</dt><dd>Liberty University Online Academy</dd></div>
            <div><dt>Intended major</dt><dd>Business (Finance)</dd></div>
            <div><dt>Honors</dt><dd>BETA Club inductee, 2025-26</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 8. Schedule: full list -->
    {schedule.length > 0 && (
    <section id="schedule" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Schedule</p>
        <h2 class="section-title">Come see her play</h2>
        <p class="mt-2 text-white/80">Clarke Central varsity girls flag football &middot; Ayn Parker wears <strong class="text-gold">#7</strong></p>
        <div class="mt-6 card divide-y divide-white/10">
          {schedule.map((g) => (
            <div class="sched-row p-4 grid grid-cols-[6.5rem_1fr] sm:grid-cols-[8rem_6rem_1fr] gap-x-4 gap-y-0.5 items-baseline">
              <span class="font-bold text-white">{g.date}</span>
              <span class="text-white/85 text-sm sm:order-none">{g.time}</span>
              <span class="col-span-2 sm:col-span-1 text-white">
                <span class="text-white/85">{g.ha === '@' ? 'at' : 'vs'}</span> <span class="font-semibold">{g.opponent}</span>{g.region && <span class="badge-red ml-2">Region</span>}
                {g.note && <span class="block text-xs text-white/85 mt-0.5">{g.note}</span>}
              </span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-white/85"><a class="link-gold" href={MAXPREPS_SCHEDULE} target="_blank" rel="noopener">Schedule via MaxPreps</a></p>
      </div>
    </section>
    )}

    <!-- 9. Contact (form posts to /api/contact; no email or phone on the page) -->
    <section id="contact" class="section contact-sec">
      <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] gap-6 lg:gap-12">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">Get in touch</h2>
          <p class="mt-2 text-white/80">Send me a note and I'll get back to you.</p>
          <p class="mt-4 text-sm text-white/80">Find me on:
            <a class="link-gold font-semibold ml-1" href="https://www.youtube.com/@APU-2029" target="_blank" rel="noopener">YouTube</a>
            <span class="text-white/80" aria-hidden="true">&middot;</span>
            <a class="link-gold font-semibold" href="https://x.com/AynParkerUsry" target="_blank" rel="noopener">X @AynParkerUsry</a>
          </p>
        </div>
        <form id="contact-form" class="grid grid-cols-2 gap-x-3 sm:gap-x-4 gap-y-3" novalidate>
          <label class="field"><span>Name</span><input name="name" required maxlength="120" autocomplete="name" /></label>
          <label class="field"><span>Role <em>(optional)</em></span>
            <select name="role">
              <option value="" selected>Choose one</option>
              <option>College coach</option>
              <option>Club/HS coach</option>
              <option>Recruiter</option>
              <option>Other</option>
            </select>
          </label>
          <label class="field col-span-2"><span>School / program</span><input name="school" maxlength="160" autocomplete="organization" /></label>
          <label class="field"><span>Email</span><input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
          <label class="field"><span>Phone <em>(optional)</em></span><input name="phone" type="tel" maxlength="40" autocomplete="tel" /></label>
          <label class="field col-span-2"><span>Message</span><textarea name="message" rows="3" required maxlength="5000"></textarea></label>
          <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="col-span-2 flex flex-wrap items-center gap-4 pt-1">
            <button type="submit" class="btn-gold">Send message</button>
            <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
    <script is:inline>
      (function () {
        var f = document.getElementById('contact-form');
        var st = document.getElementById('contact-status');
        if (!f) return;
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var d = Object.fromEntries(new FormData(f).entries());
          if (!d.name || !d.email || !d.message) { st.className = 'text-sm text-glred-light'; st.textContent = 'Please fill in name, email and message.'; return; }
          d.page_url = location.href;
          var btn = f.querySelector('button[type=submit]');
          btn.disabled = true; st.className = 'text-sm text-white/80'; st.textContent = 'Sending...';
          fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
            .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
            .then(function (j) {
              if (j && j.ok) { f.reset(); st.className = 'text-sm text-gold font-semibold'; st.textContent = 'Thanks, message received.'; }
              else { st.className = 'text-sm text-glred-light'; st.textContent = (j && j.error) || 'Sorry, something went wrong. Please try again.'; }
            })
            .catch(function () { st.className = 'text-sm text-glred-light'; st.textContent = 'Sorry, something went wrong. Please try again.'; })
            .finally(function () { btn.disabled = false; });
        });
      })();
    </script>
  </main>

  <footer class="bg-ink border-t border-white/10 text-white/85 text-sm">
    <div class="max-w-6xl mx-auto px-4 py-6 flex flex-col sm:flex-row justify-between gap-1">
      <span>&copy; 2026 Ayn Parker Usry</span>
      <span>Class of 2029 &middot; Women's Flag Football</span>
    </div>
  </footer>
</Layout>

<style is:global>
  /* Clarke Central palette, sampled from album photos (portrait IMG_6520): gold #EEA43B, red #9A1F21, black #090909 */
  :root { --ink:#090909; --ink-2:#121212; --ink-3:#1a1a1a; --gold:#EEA43B; --gold-light:#F4BE6A; --red:#9A1F21; --red-light:#C2373A; }
  body { background:var(--ink); color:#fff; }
  .nav-link { transition:color .15s; } .nav-link:hover { color:var(--gold); }
