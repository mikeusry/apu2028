---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import VideoGrid from '../components/VideoGrid.astro';
// All site videos are on Mux (public playback). One line per video in src/data/site-videos.json; order = display order.
import videos from '../data/site-videos.json';
const gameVideos = videos.filter((v) => v.category === 'game');
const trainingVideos = videos.filter((v) => v.category === 'training');
// Upcoming Clarke Central games, copied from MaxPreps (src/data/flag-schedule.json). Section hides when empty.
import schedule from '../data/flag-schedule.json';
const MAXPREPS_SCHEDULE = 'https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/26-27/schedule/';
---

<Layout>
  <div class="preview-banner">Preview draft. Not launched.</div>

  <header class="sticky top-0 z-30 bg-navy/95 backdrop-blur text-white">
    <nav class="max-w-5xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="#top" class="font-extrabold tracking-tight">APU <span class="text-accent font-semibold">2029</span></a>
      <div class="hidden sm:flex gap-5 text-sm font-medium">
        <a href="#highlights" class="hover:text-accent">Highlights</a>
        <a href="#facts" class="hover:text-accent">Facts</a>
        {schedule.length > 0 && <a href="#schedule" class="hover:text-accent">Schedule</a>}
        <a href="#academics" class="hover:text-accent">Academics</a>
        <a href="#contact" class="hover:text-accent">Contact</a>
      </div>
      <a href="#contact" class="sm:hidden text-sm font-semibold bg-white text-navy px-3 py-1.5 rounded-md">Contact</a>
    </nav>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero text-white">
      <div class="max-w-5xl mx-auto px-4 py-16 md:py-24">
        <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-accent font-semibold">Women's Flag Football Recruit</p>
        <h1 class="mt-3 text-4xl md:text-6xl font-extrabold leading-tight">Ayn Parker Usry</h1>
        <div class="mt-5 flex flex-wrap gap-2 text-sm md:text-base">
          <span class="chip">Class of 2029</span>
          <span class="chip">WR / QB / Safety</span>
          <span class="chip">#7</span>
          <span class="chip">5'7"</span>
        </div>
        <p class="mt-5 text-white/80 max-w-xl"><a href="https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/" target="_blank" rel="noopener" class="underline decoration-1 underline-offset-2 hover:opacity-80">Clarke Central flag football</a> &middot; Athens, GA &middot; Multi-sport varsity athlete</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#highlights" class="btn-light">Watch highlights</a>
          <a href="#contact" class="btn-outline">Contact</a>
        </div>
      </div>
    </section>

    <!-- Videos: compact Mux thumbnail grids + one lightbox player.
         Data: src/data/site-videos.json, one line per video; category "game" or "training"; order = display order. -->
    <section id="highlights" class="section">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Game highlights</h2>
        <VideoGrid videos={gameVideos} />
        <h2 id="training" class="section-title mt-12 scroll-mt-20">Training &amp; speed</h2>
        <VideoGrid videos={trainingVideos} />
        <p class="mt-8 text-sm text-gray-600">
          <a class="font-semibold underline hover:text-sky-700" href="https://www.youtube.com/@APU-2029" target="_blank" rel="noopener">More videos on YouTube &rarr;</a>
        </p>
      </div>
    </section>

    <!-- Video lightbox (single player, loaded on first click) -->
    <div id="video-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4" role="dialog" aria-modal="true" aria-label="Video player">
      <button type="button" id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10" aria-label="Close video">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <div class="w-full max-w-5xl">
        <div id="lightbox-slot" class="aspect-video w-full bg-black rounded-lg overflow-hidden"></div>
        <p id="lightbox-title" class="mt-3 text-center text-white/90 text-sm font-semibold"></p>
      </div>
    </div>

    <script is:inline>
      (function () {
        var MUX_SRC = 'https://cdn.jsdelivr.net/npm/@mux/mux-player@3';
        var box = document.getElementById('video-lightbox');
        var slot = document.getElementById('lightbox-slot');
        var label = document.getElementById('lightbox-title');
        var player = null, loading = null;
        function loadMux() {
          if (loading) return loading;
          loading = new Promise(function (res, rej) {
            var s = document.createElement('script');
            s.src = MUX_SRC; s.onload = res; s.onerror = rej;
            document.head.appendChild(s);
          });
          return loading;
        }
        function open(btn) {
          var pid = btn.getAttribute('data-playback-id');
          var vid = btn.getAttribute('data-video-id');
          var title = btn.getAttribute('data-title') || '';
          label.textContent = title;
          var vert = btn.getAttribute('data-vertical') === '1';
          slot.style.aspectRatio = vert ? '9 / 16' : '16 / 9';
          slot.style.maxHeight = vert ? '80vh' : '';
          slot.style.width = vert ? 'auto' : '100%';
          slot.style.margin = vert ? '0 auto' : '';
          box.classList.remove('hidden'); box.classList.add('flex');
          document.body.style.overflow = 'hidden';
          loadMux().then(function () {
            if (!player) {
              player = document.createElement('mux-player');
              player.setAttribute('stream-type', 'on-demand');
              player.setAttribute('accent-color', '#062a4b');
              player.setAttribute('autoplay', 'any');
              player.style.cssText = 'width:100%;height:100%;display:block';
              slot.appendChild(player);
            }
            player.setAttribute('metadata-video-title', title);
            if (player.getAttribute('playback-id') === pid) {
              var p = player.play && player.play();
              if (p && p.catch) p.catch(function () {});
            } else {
              player.setAttribute('playback-id', pid);
            }
          });
          if (window.apuTrack && window.apuTrack.videoPlay) window.apuTrack.videoPlay(vid);
        }
        function close() {
          if (player && player.pause) player.pause();
          box.classList.add('hidden'); box.classList.remove('flex');
          document.body.style.overflow = '';
        }
        document.querySelectorAll('.video-thumb').forEach(function (b) {
          b.addEventListener('click', function () { open(b); });
        });
        document.getElementById('lightbox-close').addEventListener('click', close);
        box.addEventListener('click', function (e) { if (e.target === box) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.classList.contains('hidden')) close(); });
      })();
    </script>

    <!-- Quick facts -->
    <section id="facts" class="section bg-gray-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Quick facts</h2>
        <div class="mt-6 card grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 overflow-hidden">
          <div class="fact"><span class="label">Height</span><span class="value">5'7"</span></div>
          <div class="fact"><span class="label">Weight</span><span class="value">135 lbs</span></div>
          <div class="fact"><span class="label">GPA</span><span class="value">3.74</span></div>
          <div class="fact"><span class="label">Intended major</span><span class="value">Business (Finance)</span></div>
          <div class="fact"><span class="label">Hometown</span><span class="value">Athens, GA</span></div>
          <div class="fact"><span class="label">High school</span><span class="value"><a href="https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/" target="_blank" rel="noopener" class="underline decoration-1 underline-offset-2 hover:opacity-80">Clarke Central</a></span></div>
          <div class="fact col-span-2"><span class="label">NCAA ID</span><span class="value"><a href="https://web3.ncaa.org/ecwr3/" target="_blank" rel="noopener" class="underline decoration-1 underline-offset-2 hover:opacity-80">2509718485</a></span></div>
          <div class="fact"><span class="label">Class</span><span class="value">2029</span></div>
          <div class="fact"><span class="label">Flag position</span><span class="value">WR / QB / Safety</span></div>
          <div class="fact"><span class="label">Jersey</span><span class="value">#7</span></div>
          <div class="fact"><span class="label">Level</span><span class="value">Varsity</span></div>
          <div class="fact col-span-2 md:col-span-4"><span class="label">Softball club</span><span class="value">Top Gun Walker</span></div>
        </div>
        <div class="mt-6 card p-5 md:p-6">
          <h3 class="font-bold">Athletic background</h3>
          <div class="mt-3 grid md:grid-cols-2 gap-6 text-gray-700">
            <div>
              <p class="label">Track &amp; field</p>
              <ul class="mt-2 space-y-1.5 list-disc pl-5">
                <li>State track finalist, triple jump</li>
                <li>60m: 8.86 laser-timed (5A Georgia meet)</li>
                <li>4x100m relay leg, curve runner</li>
              </ul>
            </div>
            <div>
              <p class="label">Softball (outfield, bats R / throws R)</p>
              <ul class="mt-2 space-y-1.5 list-disc pl-5">
                <li>2026 Alliance Fastpitch 16U Tier III National Runner-Up</li>
                <li>2025 Alliance Atlantic Region Champions</li>
                <li>Exit velo 73 mph; outfield velo 65 mph</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Schedule -->
    {schedule.length > 0 && (
    <section id="schedule" class="section">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Upcoming schedule</h2>
        <p class="mt-2 text-gray-600">Clarke Central varsity girls flag football &middot; Ayn wears <strong>#7</strong></p>
        <div class="mt-6 card divide-y">
          {schedule.map((g) => (
            <div class="p-4 grid grid-cols-[6.5rem_1fr] sm:grid-cols-[8rem_6rem_1fr] gap-x-4 gap-y-0.5 items-baseline">
              <span class="font-bold text-gray-900">{g.date}</span>
              <span class="text-gray-600 text-sm sm:order-none">{g.time}</span>
              <span class="col-span-2 sm:col-span-1 text-gray-900">
                <span class="text-gray-500">{g.ha === '@' ? 'at' : 'vs'}</span> <span class="font-semibold">{g.opponent}</span>{g.region && <span class="ml-2 text-[11px] uppercase tracking-wider text-sky-700 font-semibold">Region</span>}
                {g.note && <span class="block text-xs text-gray-500 mt-0.5">{g.note}</span>}
              </span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-gray-500"><a class="underline" href={MAXPREPS_SCHEDULE} target="_blank" rel="noopener">Schedule via MaxPreps</a></p>
      </div>
    </section>
    )}

    <!-- Academics -->
    <section id="academics" class="section bg-gray-50">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Academics</h2>
        <div class="mt-6 grid sm:grid-cols-2 md:grid-cols-4 gap-4">
          <div class="card p-5"><span class="label">GPA</span><span class="value">3.74</span></div>
          <div class="card p-5"><span class="label">School</span><span class="value">Liberty University Online Academy</span></div>
          <div class="card p-5"><span class="label">Intended major</span><span class="value">Business (Finance)</span></div>
          <div class="card p-5"><span class="label">Honors</span><span class="value">BETA Club inductee, 2025-26</span></div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="section-title">Contact</h2>
        <div class="mt-6 card p-6 md:p-8">
          <p class="text-sm text-gray-500">X: <a class="underline" href="https://x.com/AynParkerUsry">@AynParkerUsry</a></p>
          <p class="mt-1 text-sm text-gray-500">YouTube: <a class="underline" href="https://www.youtube.com/@APU-2029" target="_blank" rel="noopener">@APU-2029</a></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-navy text-white/70 text-sm">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between gap-2">
      <span>&copy; 2026 Ayn Parker Usry</span>
      <span>Class of 2029 &middot; Women's Flag Football</span>
    </div>
  </footer>
</Layout>

<style is:global>
  .preview-banner { background:#fde047; color:#422006; text-align:center; font-size:.8rem; font-weight:700; padding:.4rem 1rem; }
  .hero { background: radial-gradient(1200px 500px at 80% -10%, #1d5a8c 0%, transparent 60%), linear-gradient(160deg, #041d35 0%, #062a4b 60%, #0d3a5c 100%); }
  .chip { display:inline-flex; align-items:center; padding:.35rem .8rem; border-radius:999px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.2); font-weight:600; }
  .btn-light { display:inline-flex; padding:.75rem 1.25rem; border-radius:.6rem; background:#fff; color:#062a4b; font-weight:700; }
  .btn-outline { display:inline-flex; padding:.75rem 1.25rem; border-radius:.6rem; border:2px solid rgba(255,255,255,.6); color:#fff; font-weight:700; }
  .section { padding: 3.5rem 0; }
  @media (min-width: 768px) { .section { padding: 5rem 0; } }
  .section-title { font-size:1.75rem; font-weight:800; color:#062a4b; letter-spacing:-.01em; }
  .card { background:#fff; border:1px solid #e5e7eb; border-radius:1rem; box-shadow:0 1px 2px rgba(0,0,0,.04); }
  .fact { background:#fff; padding:1.1rem 1.25rem; display:flex; flex-direction:column; gap:.35rem; }
  .label { display:block; font-size:.72rem; text-transform:uppercase; letter-spacing:.12em; color:#6b7280; font-weight:600; }
  .value { display:inline-block; font-size:1.15rem; font-weight:700; color:#111827; margin-top:.25rem; }
  .fact .value { margin-top:0; align-self:flex-start; }
</style>
