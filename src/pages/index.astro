---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

import VideoGrid from '../components/VideoGrid.astro';
// All site videos are on Mux (public playback). One line per video in src/data/site-videos.json; order = display order.
import videos from '../data/site-videos.json';
const byId = (ids: string[]) => ids.map((id) => videos.find((v) => v.id === id)).filter(Boolean) as typeof videos;
const gameVideos = videos.filter((v) => v.category === 'game');
const speedVideos = byId(['60m-dash-886', 'hurdles-region', '4x100-relay']);
const strengthVideos = byId(['box-squat-245x5x5', 'pin-squat-330', 'summer-workouts']);
// Upcoming Clarke Central games, copied from MaxPreps (src/data/flag-schedule.json). Section hides when empty.
import schedule from '../data/flag-schedule.json';
const MAXPREPS_SCHEDULE = 'https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/26-27/schedule/';
const MAXPREPS_TEAM = 'https://www.maxpreps.com/ga/athens/clarke-central-gladiators/flag-football/girls/fall/';
// Album photos (Photos > "AP Flag Football"); resized, EXIF/GPS stripped. Crop/resize only.
const gallery = [
  { src: '/photos/ayn-qb-throw-pink.jpg', w: 900, h: 1281, alt: 'Ayn #7 setting to throw in a pink Clarke Central jersey', cap: 'At QB · Oct 17, 2026', pos: '50% 35%' },
  { src: '/photos/ayn-7-ball-carry-night.jpg', w: 1200, h: 854, alt: 'Ayn #7 carrying the ball at night', cap: 'Ball in hand · Oct 17, 2026', pos: '50% 40%' },
  { src: '/photos/ayn-7-route-white.jpg', w: 842, h: 1600, alt: 'Ayn #7 in a white Clarke Central jersey on the field', cap: 'Clarke Central #7 · Sep 23, 2026', pos: '30% 55%' },
  { src: '/photos/ayn-7-white-sideline.jpg', w: 1200, h: 800, alt: 'Ayn #7 in white, seen from behind', cap: 'Clarke Central #7 · Sep 23, 2026', pos: '55% 40%' },
];
---

<Layout>
  <div class="preview-banner">Preview draft. Not launched.</div>

  <header class="sticky top-0 z-30 bg-ink/90 backdrop-blur border-b border-white/10 text-white">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="#top" class="font-extrabold tracking-tight">APU <span class="text-gold">2029</span></a>
      <div class="hidden md:flex gap-5 text-sm font-medium text-white/80">
        <a href="#film" class="nav-link">Film</a>
        <a href="#facts" class="nav-link">Facts</a>
        <a href="#speed" class="nav-link">Speed</a>
        <a href="#strength" class="nav-link">Strength</a>
        <a href="#two-sport" class="nav-link">Softball</a>
        <a href="#academics" class="nav-link">Academics</a>
        {schedule.length > 0 && <a href="#schedule" class="nav-link">Schedule</a>}
        <a href="#contact" class="nav-link">Contact</a>
      </div>
      <a href="#contact" class="md:hidden text-sm font-bold bg-gold text-ink px-3 py-1.5 rounded-md">Contact</a>
    </nav>
  </header>

  <main id="top">
    <!-- 1. Hero: running photo, dark fade so text stays readable; Ayn sits ~62% across the frame -->
    <section class="hero relative overflow-hidden text-white">
      <img src="/photos/hero-ayn-run-7.jpg" alt="Ayn Parker Usry, #7, running with the ball" width="1591" height="1045" fetchpriority="high" class="hero-img absolute inset-0 w-full h-full object-cover" />
      <div class="hero-fade absolute inset-0" aria-hidden="true"></div>
      <div class="relative max-w-6xl mx-auto px-4 hero-inner">
        <div class="max-w-md">
          <p class="uppercase tracking-[0.2em] text-xs md:text-sm text-gold font-bold">Women's flag football</p>
          <h1 class="mt-3 text-4xl md:text-6xl font-extrabold leading-[1.05]">Ayn Parker Usry</h1>
          <div class="mt-5 flex flex-wrap gap-2 text-sm md:text-base">
            <span class="chip chip-gold">#7</span>
            <span class="chip">Class of 2029</span>
            <span class="chip">WR / QB / Safety</span>
          </div>
          <p class="mt-5 text-white/80"><a href={MAXPREPS_TEAM} target="_blank" rel="noopener" class="link-gold">Clarke Central</a> &middot; Athens, GA</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#film" class="btn-gold">Watch game film</a>
            <a href="#contact" class="btn-outline">Contact</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Game film -->
    <section id="film" class="section">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Game film</p>
        <h2 class="section-title">Clarke Central highlights</h2>
        <VideoGrid videos={gameVideos} />
      </div>
    </section>

    <!-- Video lightbox (single player, loaded on first click) -->
    <div id="video-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4" role="dialog" aria-modal="true" aria-label="Video player">
      <button type="button" id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10" aria-label="Close video">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <div class="w-full max-w-5xl">
        <div id="lightbox-slot" class="aspect-video w-full bg-black rounded-lg overflow-hidden"></div>
        <p id="lightbox-title" class="mt-3 text-center text-white/90 text-sm font-semibold"></p>
      </div>
    </div>

    <script is:inline>
      (function () {
        var MUX_SRC = 'https://cdn.jsdelivr.net/npm/@mux/mux-player@3';
        var box = document.getElementById('video-lightbox');
        var slot = document.getElementById('lightbox-slot');
        var label = document.getElementById('lightbox-title');
        var player = null, loading = null;
        function loadMux() {
          if (loading) return loading;
          loading = new Promise(function (res, rej) {
            var s = document.createElement('script');
            s.src = MUX_SRC; s.onload = res; s.onerror = rej;
            document.head.appendChild(s);
          });
          return loading;
        }
        function open(btn) {
          var pid = btn.getAttribute('data-playback-id');
          var vid = btn.getAttribute('data-video-id');
          var title = btn.getAttribute('data-title') || '';
          label.textContent = title;
          var vert = btn.getAttribute('data-vertical') === '1';
          slot.style.aspectRatio = vert ? '9 / 16' : '16 / 9';
          slot.style.maxHeight = vert ? '80vh' : '';
          slot.style.width = vert ? 'auto' : '100%';
          slot.style.margin = vert ? '0 auto' : '';
          box.classList.remove('hidden'); box.classList.add('flex');
          document.body.style.overflow = 'hidden';
          loadMux().then(function () {
            if (!player) {
              player = document.createElement('mux-player');
              player.setAttribute('stream-type', 'on-demand');
              player.setAttribute('accent-color', '#EEA43B');
              player.setAttribute('autoplay', 'any');
              player.style.cssText = 'width:100%;height:100%;display:block';
              slot.appendChild(player);
            }
            player.setAttribute('metadata-video-title', title);
            if (player.getAttribute('playback-id') === pid) {
              var p = player.play && player.play();
              if (p && p.catch) p.catch(function () {});
            } else {
              player.setAttribute('playback-id', pid);
            }
          });
          if (window.apuTrack && window.apuTrack.videoPlay) window.apuTrack.videoPlay(vid);
        }
        function close() {
          if (player && player.pause) player.pause();
          box.classList.add('hidden'); box.classList.remove('flex');
          document.body.style.overflow = '';
        }
        document.querySelectorAll('.video-thumb').forEach(function (b) {
          b.addEventListener('click', function () { open(b); });
        });
        document.getElementById('lightbox-close').addEventListener('click', close);
        box.addEventListener('click', function (e) { if (e.target === box) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.classList.contains('hidden')) close(); });
      })();
    </script>

    <!-- 3. Photo break: portrait beside Quick facts -->
    <section id="facts" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 md:gap-12 items-center">
        <figure class="photo-frame aspect-[4/5] md:aspect-[3/4]">
          <img src="/photos/ayn-7-portrait-black.jpg" alt="Ayn #7 in a black Clarke Central jersey" width="900" height="1831" loading="lazy" class="w-full h-full object-cover" style="object-position:50% 22%" />
        </figure>
        <div>
          <p class="eyebrow">Quick facts</p>
          <h2 class="section-title">The basics</h2>
          <div class="mt-6 facts-grid">
            <div class="fact"><span class="label">Height</span><span class="value">5'7"</span></div>
            <div class="fact"><span class="label">Weight</span><span class="value">135 lbs</span></div>
            <div class="fact"><span class="label">Class</span><span class="value">2029</span></div>
            <div class="fact"><span class="label">Jersey</span><span class="value">#7</span></div>
            <div class="fact"><span class="label">Position</span><span class="value">WR / QB / Safety</span></div>
            <div class="fact"><span class="label">Flag team</span><span class="value"><a href={MAXPREPS_TEAM} target="_blank" rel="noopener" class="link-gold">Clarke Central</a> (varsity)</span></div>
            <div class="fact"><span class="label">Hometown</span><span class="value">Athens, GA</span></div>
            <div class="fact"><span class="label">GPA</span><span class="value">3.74</span></div>
            <div class="fact col-span-2 sm:col-span-1"><span class="label">NCAA ID</span><span class="value"><a href="https://web3.ncaa.org/ecwr3/" target="_blank" rel="noopener" class="link-gold">2509718485</a></span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Speed -->
    <section id="speed" class="section">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Speed</p>
        <h2 class="section-title">Track &amp; field</h2>
        <ul class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <li class="stat-card"><span class="stat-big">8.86</span><span class="stat-label">60m, laser-timed (5A Georgia meet)</span></li>
          <li class="stat-card"><span class="stat-big">Hurdles</span><span class="stat-label">Region track meet</span></li>
          <li class="stat-card"><span class="stat-big">4x100</span><span class="stat-label">Relay leg, curve runner</span></li>
          <li class="stat-card"><span class="stat-big">State</span><span class="stat-label">Track finalist, triple jump</span></li>
        </ul>
        <VideoGrid videos={speedVideos} />
      </div>
    </section>

    <!-- 5. Strength -->
    <section id="strength" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Strength</p>
        <h2 class="section-title">Weight room</h2>
        <p class="mt-2 text-white/70">245 lb box squat for 5x5, 330 lb pin squats, and summer work.</p>
        <VideoGrid videos={strengthVideos} />
      </div>
    </section>

    <!-- Photo break: album gallery -->
    <section id="photos" class="section">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">On the field</p>
        <h2 class="section-title">Photos</h2>
        <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          {gallery.map((p) => (
            <figure class="group">
              <div class="photo-frame aspect-[3/4]">
                <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" style={`object-position:${p.pos}`} />
              </div>
              <figcaption class="mt-2 text-xs sm:text-sm text-white/65">{p.cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Two-sport athlete -->
    <section id="two-sport" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Two-sport athlete</p>
        <h2 class="section-title">Softball</h2>
        <p class="mt-2 text-white/70">Outfielder for Top Gun Walker. Bats right, throws right.</p>
        <ul class="mt-6 grid sm:grid-cols-2 gap-3">
          <li class="honor"><span class="honor-year">2026</span><span>Alliance Fastpitch 16U Tier III National Runner-Up</span></li>
          <li class="honor"><span class="honor-year">2025</span><span>Alliance Atlantic Region Champions</span></li>
        </ul>
      </div>
    </section>

    <!-- 7. Academics -->
    <section id="academics" class="section">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Academics</p>
        <h2 class="section-title">In the classroom</h2>
        <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <div class="card p-5"><span class="label">GPA</span><span class="value">3.74</span></div>
          <div class="card p-5"><span class="label">School</span><span class="value">Liberty University Online Academy</span></div>
          <div class="card p-5"><span class="label">Intended major</span><span class="value">Business (Finance)</span></div>
          <div class="card p-5"><span class="label">Honors</span><span class="value">BETA Club inductee, 2025-26</span></div>
        </div>
        <p class="mt-3 text-sm text-white/55">Plays varsity flag football for Clarke Central.</p>
      </div>
    </section>

    <!-- 8. Schedule -->
    {schedule.length > 0 && (
    <section id="schedule" class="section bg-ink-2">
      <div class="max-w-6xl mx-auto px-4">
        <p class="eyebrow">Schedule</p>
        <h2 class="section-title">Come see her play</h2>
        <p class="mt-2 text-white/70">Clarke Central varsity girls flag football &middot; Ayn wears <strong class="text-gold">#7</strong></p>
        <div class="mt-6 card divide-y divide-white/10">
          {schedule.map((g) => (
            <div class="sched-row p-4 grid grid-cols-[6.5rem_1fr] sm:grid-cols-[8rem_6rem_1fr] gap-x-4 gap-y-0.5 items-baseline">
              <span class="font-bold text-white">{g.date}</span>
              <span class="text-white/60 text-sm sm:order-none">{g.time}</span>
              <span class="col-span-2 sm:col-span-1 text-white">
                <span class="text-white/50">{g.ha === '@' ? 'at' : 'vs'}</span> <span class="font-semibold">{g.opponent}</span>{g.region && <span class="badge-red ml-2">Region</span>}
                {g.note && <span class="block text-xs text-white/50 mt-0.5">{g.note}</span>}
              </span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-white/50"><a class="link-gold" href={MAXPREPS_SCHEDULE} target="_blank" rel="noopener">Schedule via MaxPreps</a></p>
      </div>
    </section>
    )}

    <!-- 9. Contact (form posts to /api/contact; no email or phone on the page) -->
    <section id="contact" class="section">
      <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-8">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">Get in touch</h2>
          <p class="mt-2 text-white/70">Coaches and recruiters: send a note and we'll get back to you.</p>
          <form id="contact-form" class="mt-6 card p-5 md:p-7 grid sm:grid-cols-2 gap-4" novalidate>
            <label class="field"><span>Name</span><input name="name" required maxlength="120" autocomplete="name" /></label>
            <label class="field"><span>Role</span>
              <select name="role" required>
                <option value="" selected disabled>Choose one</option>
                <option>College coach</option>
                <option>Club/HS coach</option>
                <option>Recruiter</option>
                <option>Other</option>
              </select>
            </label>
            <label class="field sm:col-span-2"><span>School / program</span><input name="school" maxlength="160" autocomplete="organization" /></label>
            <label class="field"><span>Email</span><input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
            <label class="field"><span>Phone <em>(optional)</em></span><input name="phone" type="tel" maxlength="40" autocomplete="tel" /></label>
            <label class="field sm:col-span-2"><span>Message</span><textarea name="message" rows="5" required maxlength="5000"></textarea></label>
            <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
              <button type="submit" class="btn-gold">Send message</button>
              <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>
        <aside class="lg:pt-24">
          <div class="card p-6">
            <h3 class="font-bold text-white">More from Ayn</h3>
            <p class="mt-3 text-white/70"><a class="link-gold font-semibold" href="https://www.youtube.com/@APU-2029" target="_blank" rel="noopener">YouTube: @APU-2029 &rarr;</a></p>
            <p class="mt-2 text-white/70"><a class="link-gold font-semibold" href="https://x.com/AynParkerUsry" target="_blank" rel="noopener">X: @AynParkerUsry &rarr;</a></p>
          </div>
        </aside>
      </div>
    </section>
    <script is:inline>
      (function () {
        var f = document.getElementById('contact-form');
        var st = document.getElementById('contact-status');
        if (!f) return;
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var d = Object.fromEntries(new FormData(f).entries());
          if (!d.name || !d.role || !d.email || !d.message) { st.className = 'text-sm text-glred-light'; st.textContent = 'Please fill in name, role, email and message.'; return; }
          d.page_url = location.href;
          var btn = f.querySelector('button[type=submit]');
          btn.disabled = true; st.className = 'text-sm text-white/70'; st.textContent = 'Sending...';
          fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d) })
            .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
            .then(function (j) {
              if (j && j.ok) { f.reset(); st.className = 'text-sm text-gold font-semibold'; st.textContent = 'Thanks, message received.'; }
              else { st.className = 'text-sm text-glred-light'; st.textContent = (j && j.error) || 'Sorry, something went wrong. Please try again.'; }
            })
            .catch(function () { st.className = 'text-sm text-glred-light'; st.textContent = 'Sorry, something went wrong. Please try again.'; })
            .finally(function () { btn.disabled = false; });
        });
      })();
    </script>
  </main>

  <footer class="bg-ink border-t border-white/10 text-white/60 text-sm">
    <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col sm:flex-row justify-between gap-2">
      <span>&copy; 2026 Ayn Parker Usry</span>
      <span>Class of 2029 &middot; Women's Flag Football</span>
    </div>
  </footer>
</Layout>

<style is:global>
  /* Clarke Central palette, sampled from album photos (portrait IMG_6520): gold #EEA43B, red #9A1F21, black #090909 */
  :root { --ink:#090909; --ink-2:#121212; --ink-3:#1a1a1a; --gold:#EEA43B; --gold-light:#F4BE6A; --red:#9A1F21; --red-light:#C2373A; }
  body { background:var(--ink); color:#fff; }
  .preview-banner { background:var(--gold); color:var(--ink); text-align:center; font-size:.8rem; font-weight:800; padding:.4rem 1rem; }
  .nav-link { transition:color .15s; } .nav-link:hover { color:var(--gold); }
  .hero { min-height: 92vh; display:flex; align-items:flex-end; background:var(--ink); }
  .hero-img { object-position: 62% 40%; }
  .hero-fade { background: linear-gradient(180deg, rgba(9,9,9,.15) 0%, rgba(9,9,9,0) 30%, rgba(9,9,9,.55) 55%, rgba(9,9,9,.94) 76%, var(--ink) 100%); }
  .hero-inner { width:100%; padding-top: 52vh; padding-bottom: 2.75rem; }
  @media (min-width: 768px) {
    .hero { min-height: 640px; height: 86vh; max-height: 900px; align-items:center; }
    .hero-img { object-position: 62% 45%; }
    .hero-fade { background:
      linear-gradient(90deg, rgba(9,9,9,.94) 0%, rgba(9,9,9,.82) 28%, rgba(9,9,9,.35) 46%, rgba(9,9,9,0) 60%),
      linear-gradient(180deg, rgba(9,9,9,0) 62%, rgba(9,9,9,.7) 84%, var(--ink) 100%); }
    .hero-inner { padding-top: 4rem; padding-bottom: 4rem; }
  }
  .chip { display:inline-flex; align-items:center; padding:.35rem .8rem; border-radius:999px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.22); font-weight:600; }
  .chip-gold { background:var(--gold); border-color:var(--gold); color:var(--ink); font-weight:800; }
  .btn-gold { display:inline-flex; padding:.75rem 1.25rem; border-radius:.6rem; background:var(--gold); color:var(--ink); font-weight:800; transition:background .15s; }
  .btn-gold:hover { background:var(--gold-light); } .btn-gold:disabled { opacity:.6; }
  .btn-outline { display:inline-flex; padding:.75rem 1.25rem; border-radius:.6rem; border:2px solid rgba(255,255,255,.6); color:#fff; font-weight:700; transition:border-color .15s, color .15s; }
  .btn-outline:hover { border-color:var(--gold); color:var(--gold); }
  .link-gold { color:var(--gold); text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:2px; } .link-gold:hover { color:var(--gold-light); }
  .section { padding: 3.5rem 0; }
  @media (min-width: 768px) { .section { padding: 5rem 0; } }
  .bg-ink-2 { background:var(--ink-2); }
  .eyebrow { font-size:.75rem; text-transform:uppercase; letter-spacing:.2em; font-weight:800; color:var(--gold); }
  .eyebrow::before { content:''; display:inline-block; width:1.5rem; height:3px; background:var(--red-light); vertical-align:middle; margin-right:.6rem; border-radius:2px; }
  .section-title { margin-top:.35rem; font-size:1.9rem; font-weight:800; color:#fff; letter-spacing:-.01em; line-height:1.15; }
  .card { background:var(--ink-3); border:1px solid rgba(255,255,255,.1); border-radius:1rem; }
  .facts-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.1); border-radius:1rem; overflow:hidden; }
  @media (min-width: 640px) { .facts-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  .fact { background:var(--ink-3); padding:1rem 1.15rem; display:flex; flex-direction:column; gap:.3rem; }
  .label { display:block; font-size:.7rem; text-transform:uppercase; letter-spacing:.12em; color:rgba(255,255,255,.55); font-weight:700; }
  .value { display:inline-block; font-size:1.1rem; font-weight:700; color:#fff; margin-top:.25rem; }
  .fact .value { margin-top:0; align-self:flex-start; }
  .photo-frame { overflow:hidden; border-radius:1rem; background:#000; border:1px solid rgba(255,255,255,.1); }
