---
// Lead clip + smaller grid. variant 'feature': lead full width, rest in a grid below (game film).
// variant 'side': lead takes 2/3 on desktop with the rest stacked beside it; on mobile lead then a 2-up grid (track, strength).
import VideoThumb from './VideoThumb.astro';
interface Video { id: string; playbackId: string; title: string; caption: string; thumbTime?: number; vertical?: boolean; duration?: string; bright?: number; youtubeId?: string }
const { videos, label, variant = 'side' } = Astro.props as { videos: Video[]; label?: string; variant?: 'feature' | 'side' };
const [lead, ...rest] = videos;
---
{lead && variant === 'feature' && (
  <div class="mt-5">
    <VideoThumb v={lead} size="lg" label={label} />
    {rest.length > 0 && (
      <div class="mt-4 sm:mt-5 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
        {rest.map((v) => <VideoThumb v={v} size="sm" />)}
      </div>
    )}
  </div>
)}
{lead && variant === 'side' && (
  <div class="mt-5 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
    <div class="col-span-2 lg:row-span-2"><VideoThumb v={lead} size="md" label={label} /></div>
    {rest.map((v) => <VideoThumb v={v} size="sm" />)}
  </div>
)}
